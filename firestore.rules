rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Salesman profiles and their personal product rates.
    // The client creates only role="salesman" profiles; no client can create an admin role.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.role == 'salesman';
      allow update: if request.auth != null && (
        request.auth.uid == userId || request.resource.data.role == resource.data.role
      );
      allow delete: if request.auth != null && request.resource.data.role == 'salesman';
    }
  }
}
