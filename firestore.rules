rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isSalesman() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'salesman';
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (isSalesman() && resource.data.salesmanId == request.auth.uid);
      allow update, delete: if isAdmin() ||
        (isSalesman() && resource.data.salesmanId == request.auth.uid &&
         resource.data.status in ['salesman_pending','pending_admin']);
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if isAdmin() && request.resource.data.role == 'salesman';
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      // Customers can read only public coupons. Private coupon documents (including
      // selected customer information) are never readable from the public client.
      allow get, list: if isAdmin() || resource.data.visibility == 'public';
      allow create, update, delete: if isAdmin();
    }

    match /publicOrderTracking/{trackingId} {
      allow get: if true;
      allow list: if false;
      allow create: if true;
      allow update, delete: if isAdmin() ||
        (isSalesman() && resource.data.salesmanId == request.auth.uid);
    }

    match /publicSalesmen/{salesmanId} {
      allow read: if true;
      allow create, update: if isSalesman() && request.auth.uid == salesmanId;
      allow delete: if isAdmin() || (isSalesman() && request.auth.uid == salesmanId);
    }
  }
}
